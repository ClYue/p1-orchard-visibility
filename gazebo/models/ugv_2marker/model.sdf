<?xml version="1.0"?>
<sdf version="1.8">
  <model name="ugv_2marker">
    <self_collide>false</self_collide>

    <link name="chassis">
      <!-- 模型原点在地面；底盘中心 z=0.16（底面 0.10 与轮轴同高） -->
      <inertial>
        <pose>0 0 0.16 0 0 0</pose>
        <mass>8.0</mass>
        <inertia><ixx>0.0960</ixx><iyy>0.1792</iyy><izz>0.2533</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="chassis_col">
        <pose>0 0 0.16 0 0 0</pose>
        <geometry><box><size>0.5 0.36 0.12</size></box></geometry>
      </collision>
      <visual name="chassis_vis">
        <pose>0 0 0.16 0 0 0</pose>
        <geometry><box><size>0.5 0.36 0.12</size></box></geometry>
        <material><ambient>0.20 0.25 0.35 1</ambient><diffuse>0.30 0.38 0.55 1</diffuse></material>
      </visual>
      <!-- 前后万向滚球（无摩擦，静平衡用） -->
      <collision name="caster_f_col">
        <pose>0.20 0 0.04 0 0 0</pose>
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
      <visual name="caster_f_vis">
        <pose>0.20 0 0.04 0 0 0</pose>
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="caster_r_col">
        <pose>-0.20 0 0.04 0 0 0</pose>
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
      <visual name="caster_r_vis">
        <pose>-0.20 0 0.04 0 0 0</pose>
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <!-- 前后标志板：中心 (±0.5, 0, 0.30)，板面 0.24(y) x 0.25(z) -->
      <visual name="marker_front_vis">
        <pose>0.5 0 0.30 0 0 0</pose>
        <geometry><box><size>0.02 0.24 0.25</size></box></geometry>
        <material><ambient>0.90 0.45 0.05 1</ambient><diffuse>0.95 0.50 0.08 1</diffuse></material>
      </visual>
      <visual name="marker_rear_vis">
        <pose>-0.5 0 0.30 0 0 0</pose>
        <geometry><box><size>0.02 0.24 0.25</size></box></geometry>
        <material><ambient>0.90 0.45 0.05 1</ambient><diffuse>0.95 0.50 0.08 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_left">
      <pose>0 0.22 0.10 1.5708 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <inertia><ixx>0.00168</ixx><iyy>0.00168</iyy><izz>0.003</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_right">
      <pose>0 -0.22 0.10 1.5708 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <inertia><ixx>0.00168</ixx><iyy>0.00168</iyy><izz>0.003</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <joint name="wheel_left_joint" type="revolute">
      <parent>chassis</parent>
      <child>wheel_left</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="wheel_right_joint" type="revolute">
      <parent>chassis</parent>
      <child>wheel_right</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/model/ugv_2marker/odometry</odom_topic>
      <max_linear_acceleration>3.0</max_linear_acceleration>
      <max_angular_acceleration>6.0</max_angular_acceleration>
    </plugin>

    <plugin filename="ignition-gazebo-pose-publisher-system" name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <update_frequency>50</update_frequency>
    </plugin>
  </model>
</sdf>
